{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ub-mode-php analyzer response v1",
  "type": "object",
  "required": ["schema_version", "units", "diagnostics"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "namespace", "name", "kind", "start_line", "end_line", "complexity", "node_count", "features"],
        "properties": {
          "id": {"type": "string"},
          "file": {"type": "string"},
          "namespace": {"type": "string"},
          "name": {"type": "string"},
          "kind": {"enum": ["function", "method", "closure", "arrow"]},
          "start_line": {"type": "integer", "minimum": 1},
          "end_line": {"type": "integer", "minimum": 1},
          "complexity": {"type": "integer", "minimum": 1},
          "node_count": {"type": "integer", "minimum": 0},
          "features": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "message"],
        "properties": {"file": {"type": "string"}, "message": {"type": "string"}},
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
